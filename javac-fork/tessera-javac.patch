+    /**
+     * Tessera: an unsigned integer ({@code uint}, {@code ulong}, {@code uint<N>}) or a raw bit
+     * vector ({@code bits<N>}) of {@code bits} bits. It is an {@code int} (up to 32 bits) or a
+     * {@code long} everywhere outside attribution and lowering, so class files are unchanged.
+     */
+    public static class UnsignedType extends JCPrimitiveType {
+        public final int bits;
+        public final boolean raw;
+        private final UnsignedType canonical;
+
+        public UnsignedType(TypeTag tag, TypeSymbol tsym, int bits, boolean raw) {
+            super(tag, tsym, List.nil());
+            this.bits = bits;
+            this.raw = raw;
+            this.canonical = this;
+        }
+
+        private UnsignedType(UnsignedType canonical, List<TypeMetadata> md) {
+            super(canonical.getTag(), canonical.tsym, md);
+            this.bits = canonical.bits;
+            this.raw = canonical.raw;
+            this.canonical = canonical;
+        }
+
+        @Override
+        protected JCPrimitiveType cloneWithMetadata(List<TypeMetadata> md) {
+            return new UnsignedType(canonical, md);
+        }
+
+        @Override
+        public Type baseType() {
+            return canonical;
+        }
+
+        @Override
+        public String toString() {
+            if (raw) return "bits<" + bits + ">";
+            return switch (bits) {
+                case 8 -> "ubyte";
+                case 16 -> "ushort";
+                case 32 -> "uint";
+                case 64 -> "ulong";
+                default -> "uint<" + bits + ">";
+            };
+        }
+    }
+
