diff --git a/src/jdk.compiler/share/classes/com/sun/tools/javac/comp/TesseraSyntax.java b/src/jdk.compiler/share/classes/com/sun/tools/javac/comp/TesseraSyntax.java
new file mode 100644
index 000000000..4ca3e2715
--- /dev/null
+++ b/src/jdk.compiler/share/classes/com/sun/tools/javac/comp/TesseraSyntax.java
@@ -0,0 +1,635 @@
+/*
+ * Tessera language extensions for javac (GPL-2.0 with Classpath Exception, like the rest of javac).
+ *
+ *  - unsigned primitives: uint, ulong, ushort, ubyte, uint<N> (1..64) and raw bit vectors bits<N>,
+ *    with literals 123u / 123uL; they are int/long in class files;
+ *  - bit selects x[i], slices x[hi:lo] and concatenation {a, b} on those types;
+ *  - operators (+ - * & | ^ ~ << >> >>> < <= > >=, x[i], x[hi:lo], {a, b}) on reference types
+ *    whose methods carry an annotation named @Operator("+") etc.;
+ *  - automatic names: a local variable of a type with a static @Operator("name") method is
+ *    initialised through that method, which receives the variable's name.
+ */
+package com.sun.tools.javac.comp;
+
+import com.sun.tools.javac.code.Attribute;
+import com.sun.tools.javac.code.Flags;
+import com.sun.tools.javac.code.Kinds.Kind;
+import com.sun.tools.javac.code.Symbol;
+import com.sun.tools.javac.code.Symbol.ClassSymbol;
+import com.sun.tools.javac.code.Symbol.MethodSymbol;
+import com.sun.tools.javac.code.Symbol.OperatorSymbol;
+import com.sun.tools.javac.code.Symtab;
+import com.sun.tools.javac.code.Type;
+import com.sun.tools.javac.code.Type.UnsignedType;
+import com.sun.tools.javac.code.TypeTag;
+import com.sun.tools.javac.code.Types;
+import com.sun.tools.javac.resources.CompilerProperties.Errors;
+import com.sun.tools.javac.tree.JCTree;
+import com.sun.tools.javac.tree.JCTree.*;
+import com.sun.tools.javac.tree.TreeInfo;
+import com.sun.tools.javac.tree.TreeMaker;
+import com.sun.tools.javac.tree.TreeTranslator;
+import com.sun.tools.javac.util.Context;
+import com.sun.tools.javac.util.JCDiagnostic.DiagnosticPosition;
+import com.sun.tools.javac.util.List;
+import com.sun.tools.javac.util.ListBuffer;
+import com.sun.tools.javac.util.Log;
+import com.sun.tools.javac.util.Name;
+import com.sun.tools.javac.util.Names;
+
+import java.util.IdentityHashMap;
+import java.util.Map;
+
+import static com.sun.tools.javac.code.TypeTag.*;
+
+public class TesseraSyntax {
+    protected static final Context.Key<TesseraSyntax> key = new Context.Key<>();
+
+    public static TesseraSyntax instance(Context context) {
+        TesseraSyntax instance = context.get(key);
+        if (instance == null) instance = new TesseraSyntax(context);
+        return instance;
+    }
+
+    private final Symtab syms;
+    private final Types types;
+    private final Names names;
+    private final Log log;
+    private final Resolve rs;
+    private final Operators operators;
+    private final Map<Integer, UnsignedType> unsignedTypes = new java.util.HashMap<>();
+    /** Expressions rewritten to method calls during attribution, replaced during lowering. */
+    private final Map<JCTree, JCExpression> replacements = new IdentityHashMap<>();
+
+    @SuppressWarnings("this-escape")
+    protected TesseraSyntax(Context context) {
+        context.put(key, this);
+        syms = Symtab.instance(context);
+        types = Types.instance(context);
+        names = Names.instance(context);
+        log = Log.instance(context);
+        rs = Resolve.instance(context);
+        operators = Operators.instance(context);
+    }
+
+    // ------------------------------------------------------------------ types
+
+    /** The unsigned (or raw, for bits<N>) type of the given width. */
+    public UnsignedType unsigned(int bits, boolean raw) {
+        return unsignedTypes.computeIfAbsent(raw ? -bits : bits, k -> {
+            Type base = bits <= 32 ? syms.intType : syms.longType;
+            return new UnsignedType(base.getTag(), base.tsym, bits, raw);
+        });
+    }
+
+    public static boolean isUnsigned(Type t) {
+        return t instanceof UnsignedType;
+    }
+
+    static int bitsOf(Type t) {
+        return t instanceof UnsignedType u ? u.bits : t.hasTag(LONG) ? 64 : 32;
+    }
+
+    static long mask(int bits) {
+        return bits >= 64 ? -1L : (1L << bits) - 1;
+    }
+
+    /** The Java spelling of an operator, as used in {@code @Operator("...")}. */
+    static String opName(JCTree.Tag tag) {
+        return switch (tag) {
+            case PLUS, POS -> "+";
+            case MINUS, NEG -> "-";
+            case MUL -> "*";
+            case DIV -> "/";
+            case MOD -> "%";
+            case BITAND -> "&";
+            case BITOR -> "|";
+            case BITXOR -> "^";
+            case COMPL -> "~";
+            case NOT -> "!";
+            case SL -> "<<";
+            case SR -> ">>";
+            case USR -> ">>>";
+            case LT -> "<";
+            case LE -> "<=";
+            case GT -> ">";
+            case GE -> ">=";
+            case EQ -> "==";
+            case NE -> "!=";
+            case AND -> "&&";
+            case OR -> "||";
+            case PREINC, POSTINC -> "++";
+            case PREDEC, POSTDEC -> "--";
+            default -> tag.toString();
+        };
+    }
+
+    private void error(DiagnosticPosition pos, String msg) {
+        log.error(pos, Errors.Tessera(msg));
+    }
+
+    // ------------------------------------------------------------------ attribution hooks
+
+    /** The type of a cast from or to an unsigned type; constants are converted with unsigned semantics. */
+    Type castConstant(Type from, Type to) {
+        Object cv = from.constValue();
+        if (cv == null || !(cv instanceof Number n)) return to.baseType();
+        long v = n.longValue();
+        if (isUnsigned(from) && from.getTag() == INT) v &= 0xFFFF_FFFFL; // zero-extend
+        int bits = isUnsigned(to) ? ((UnsignedType) to).bits : to.hasTag(LONG) ? 64 : to.hasTag(INT) ? 32
+                : to.hasTag(SHORT) || to.hasTag(CHAR) ? 16 : to.hasTag(BYTE) ? 8 : 64;
+        if (isUnsigned(to)) v &= mask(bits);
+        Object nv = switch (to.getTag()) {
+            case LONG -> v;
+            case INT -> (int) v;
+            case SHORT -> (int) (short) v;
+            case CHAR -> (int) (char) v;
+            case BYTE -> (int) (byte) v;
+            case FLOAT -> isUnsigned(from) && from.getTag() == LONG && n.longValue() < 0
+                    ? (float) new java.math.BigInteger(Long.toUnsignedString(n.longValue())).doubleValue() : (float) v;
+            case DOUBLE -> isUnsigned(from) && from.getTag() == LONG && n.longValue() < 0
+                    ? new java.math.BigInteger(Long.toUnsignedString(n.longValue())).doubleValue() : (double) v;
+            default -> cv;
+        };
+        return to.baseType().constType(nv);
+    }
+
+    /** The type of {@code left op right} when an operand is unsigned (null: not unsigned). */
+    Type binaryType(JCBinary tree, Type left, Type right, Type operatorResult) {
+        boolean ul = isUnsigned(left), ur = isUnsigned(right);
+        if (!ul && !ur) return null;
+        if (operatorResult.hasTag(CLASS)) return null; // string concatenation
+        String op = opName(tree.getTag());
+        boolean raw = (ul && ((UnsignedType) left).raw) || (ur && ((UnsignedType) right).raw);
+        if (raw) {
+            switch (tree.getTag()) {
+                case BITAND, BITOR, BITXOR, SL, SR, USR, EQ, NE -> {}
+                default -> error(tree.pos(), "operator " + op + " is not defined for bit vectors; convert with (uint<N>) first");
+            }
+        }
+        if (operatorResult.hasTag(BOOLEAN) || operatorResult.hasTag(CLASS)) return null;
+        if (tree.hasTag(JCTree.Tag.SL) || tree.hasTag(JCTree.Tag.SR) || tree.hasTag(JCTree.Tag.USR))
+            return ul ? left.baseType() : null;
+        int bits = Math.max(ul ? ((UnsignedType) left).bits : 0, ur ? ((UnsignedType) right).bits : 0);
+        if (operatorResult.hasTag(LONG)) bits = Math.max(bits, (ul && ur) ? bits : 64);
+        return unsigned(Math.min(bits, operatorResult.hasTag(LONG) ? 64 : 32), raw);
+    }
+
+    Type unaryType(JCUnary tree, Type arg) {
+        if (!isUnsigned(arg)) return null;
+        var u = (UnsignedType) arg;
+        if (u.raw && !tree.hasTag(JCTree.Tag.COMPL))
+            error(tree.pos(), "operator " + opName(tree.getTag()) + " is not defined for bit vectors");
+        return arg.baseType();
+    }
+
+    /** Methods of {@code site} (or its superclasses) annotated {@code @Operator(op)}. */
+    Name operatorMethod(Type site, String op, boolean wantStatic) {
+        if (site == null || !site.hasTag(CLASS)) return null;
+        for (Type t = site; t != null && t.hasTag(CLASS); t = types.supertype(t)) {
+            var c = (ClassSymbol) t.tsym;
+            for (Symbol s : c.members().getSymbols(s -> s.kind == Kind.MTH)) {
+                if (wantStatic != ((s.flags() & Flags.STATIC) != 0)) continue;
+                for (Attribute.Compound a : s.getDeclarationAttributes()) {
+                    if (!a.type.tsym.getSimpleName().contentEquals("Operator")) continue;
+                    for (var p : a.values) {
+                        if (p.snd.getValue() instanceof String v && v.equals(op)) return s.name;
+                        if (p.snd instanceof Attribute.Array arr)
+                            for (Attribute e : arr.values)
+                                if (e.getValue() instanceof String v && v.equals(op)) return s.name;
+                    }
+                }
+            }
+        }
+        return null;
+    }
+
+    /** {@code lhs.method(rhs)} for an overloaded binary operator on a reference type, or null. */
+    JCExpression binaryOperatorCall(TreeMaker make, JCBinary tree, Type left, Type right) {
+        if (left.isPrimitive() || left.hasTag(ERROR)) return null;
+        if (tree.hasTag(JCTree.Tag.PLUS) && (types.isSameType(left, syms.stringType) || types.isSameType(right, syms.stringType)))
+            return null;
+        switch (tree.getTag()) {
+            case EQ, NE, AND, OR -> { return null; }
+            default -> {}
+        }
+        if (types.unboxedType(left).isPrimitive()) return null;
+        Name m = operatorMethod(left, opName(tree.getTag()), false);
+        if (m == null) return null;
+        var call = make.at(tree.pos).Apply(List.nil(), make.at(tree.pos).Select(tree.lhs, m), List.of(tree.rhs));
+        return call;
+    }
+
+    JCExpression unaryOperatorCall(TreeMaker make, JCUnary tree, Type arg) {
+        if (arg.isPrimitive() || arg.hasTag(ERROR) || types.unboxedType(arg).isPrimitive()) return null;
+        if (tree.getTag().isIncOrDecUnaryOp()) return null;
+        Name m = operatorMethod(arg, opName(tree.getTag()), false);
+        if (m == null) return null;
+        return make.at(tree.pos).Apply(List.nil(), make.at(tree.pos).Select(tree.arg, m), List.nil());
+    }
+
+    JCExpression indexOperatorCall(TreeMaker make, JCArrayAccess tree, Type indexed) {
+        if (indexed.isPrimitive() || indexed.hasTag(ERROR) || types.isArray(indexed)) return null;
+        boolean slice = tree instanceof JCSlice;
+        Name m = operatorMethod(indexed, slice ? "[:]" : "[]", false);
+        if (m == null) return null;
+        var args = slice ? List.of(tree.index, ((JCSlice) tree).lo) : List.of(tree.index);
+        return make.at(tree.pos).Apply(List.nil(), make.at(tree.pos).Select(tree.indexed, m), args);
+    }
+
+    JCExpression concatOperatorCall(TreeMaker make, JCNewArray tree, Type first) {
+        if (first.isPrimitive() || first.hasTag(ERROR)) return null;
+        Name m = operatorMethod(first, "{}", false);
+        if (m == null) return null;
+        return make.at(tree.pos).Apply(List.nil(), make.at(tree.pos).Select(tree.elems.head, m), tree.elems.tail);
+    }
+
+    void replace(JCTree original, JCExpression with) {
+        replacements.put(original, with);
+    }
+
+    /** Type of x[i] / x[hi:lo] on an unsigned value, or null when x is not unsigned. */
+    Type indexType(JCArrayAccess tree, Type indexed, Type index, Type lo) {
+        if (!isUnsigned(indexed)) return null;
+        var u = (UnsignedType) indexed;
+        if (tree instanceof JCSlice) {
+            Object hi = index.constValue(), l = lo == null ? null : lo.constValue();
+            if (!(hi instanceof Number h) || !(l instanceof Number ln)) {
+                error(tree.pos(), "slice bounds must be constants");
+                return u;
+            }
+            int hv = h.intValue(), lv = ln.intValue();
+            if (lv < 0 || hv >= u.bits || hv < lv) {
+                error(tree.pos(), "slice [" + hv + ":" + lv + "] out of range for " + u);
+                return u;
+            }
+            return unsigned(hv - lv + 1, u.raw);
+        }
+        return syms.booleanType;
+    }
+
+    Type concatType(JCNewArray tree, List<Type> elems) {
+        int bits = 0;
+        boolean raw = false;
+        for (Type t : elems) {
+            if (!isUnsigned(t)) return null;
+            bits += ((UnsignedType) t).bits;
+            raw |= ((UnsignedType) t).raw;
+        }
+        if (bits > 64) {
+            error(tree.pos(), "concatenation is " + bits + " bits wide; at most 64 bits are supported");
+            bits = 64;
+        }
+        return unsigned(bits, raw);
+    }
+
+    // ------------------------------------------------------------------ lowering
+
+    /** Rewrite the Tessera constructs of a class into plain Java (before erasure). */
+    public JCTree lower(Env<AttrContext> env, JCTree tree, TreeMaker make) {
+        return new Lowerer(env, make).translate(tree);
+    }
+
+    private final class Lowerer extends TreeTranslator {
+        final Env<AttrContext> env;
+        final TreeMaker make;
+        Type methodReturn;
+
+        Lowerer(Env<AttrContext> env, TreeMaker make) {
+            this.env = env;
+            this.make = make;
+        }
+
+        // ---------------- helpers building attributed trees
+
+        JCExpression intLit(TypeTag tag, long v) {
+            Object val = tag == LONG ? (Object) v : (Object) (int) v;
+            Type t = (tag == LONG ? syms.longType : syms.intType).constType(val);
+            return make.Literal(tag, val).setType(t);
+        }
+
+        JCBinary binary(JCTree.Tag tag, JCExpression l, JCExpression r, Type resultType) {
+            OperatorSymbol op = operators.resolveBinary(l, tag, l.type.baseType(), r.type.baseType());
+            JCBinary b = make.Binary(tag, l, r);
+            b.operator = op;
+            b.type = resultType;
+            return b;
+        }
+
+        JCExpression masked(JCExpression e, Type t) {
+            if (!(t instanceof UnsignedType u)) return e;
+            if (u.bits == 32 || u.bits == 64) return e;
+            return binary(JCTree.Tag.BITAND, e, intLit(u.getTag(), mask(u.bits)), u);
+        }
+
+        JCExpression call(Type site, String name, List<Type> argtypes, List<JCExpression> args) {
+            MethodSymbol m = rs.resolveInternalMethod(env.tree.pos(), env, site, names.fromString(name), argtypes, List.nil());
+            JCExpression c = make.App(make.QualIdent(m), args);
+            return c;
+        }
+
+        /** Zero-extend a 32-bit unsigned value used where a long (or float/double) is expected. */
+        JCExpression coerce(JCExpression e, Type target) {
+            if (!(e.type instanceof UnsignedType u) || u.getTag() != INT) return e;
+            if (!(target.hasTag(LONG) || target.hasTag(FLOAT) || target.hasTag(DOUBLE))) return e;
+            JCExpression asLong = make.TypeCast(syms.longType, e).setType(syms.longType);
+            JCExpression z = binary(JCTree.Tag.BITAND, asLong, intLit(LONG, 0xFFFF_FFFFL), syms.longType);
+            if (target.hasTag(LONG)) return z;
+            return make.TypeCast(target, z).setType(target);
+        }
+
+        boolean isConstFitting(Type found, int bits) {
+            Object c = found.constValue();
+            if (!(c instanceof Number n)) return false;
+            long v = n.longValue();
+            if (isUnsigned(found)) return bits >= 64 || Long.compareUnsigned(v & mask(bitsOf(found)), mask(bits)) <= 0;
+            return v >= 0 && (bits >= 64 || v <= mask(bits));
+        }
+
+        /** Signedness rules for assigning {@code found} where {@code req} is expected. */
+        void checkAssign(DiagnosticPosition pos, Type found, Type req) {
+            if (found == null || req == null || found.hasTag(ERROR) || req.hasTag(ERROR)) return;
+            boolean uf = isUnsigned(found), ur = isUnsigned(req);
+            if (ur && !uf) {
+                if (found.isNumeric() && !isConstFitting(found, ((UnsignedType) req).bits))
+                    error(pos, "cannot convert signed " + found.baseType() + " to " + req + " implicitly; use a cast (" + req + ")");
+            } else if (uf && !ur) {
+                if (req.hasTag(LONG) && found.getTag() == INT) return; // zero-extension
+                if (req.hasTag(FLOAT) || req.hasTag(DOUBLE)) return;
+                if (!req.isPrimitive())
+                    error(pos, "unsigned value " + found + " cannot be boxed to " + req);
+                else
+                    error(pos, "cannot convert " + found + " to signed " + req + " implicitly; use a cast (" + req + ")");
+            } else if (uf) {
+                var a = (UnsignedType) found;
+                var b = (UnsignedType) req;
+                if (a.raw != b.raw && !isConstFitting(found, b.bits))
+                    error(pos, "cannot convert " + found + " to " + req + " implicitly; use a cast");
+                else if (a.bits > b.bits && !isConstFitting(found, b.bits))
+                    error(pos, found + " is wider than " + req + "; narrow it with a cast (" + req + ")");
+            }
+        }
+
+        // ---------------- tree visitors
+
+        @Override
+        public <T extends JCTree> T translate(T tree) {
+            if (tree != null && replacements.containsKey(tree)) {
+                @SuppressWarnings("unchecked")
+                T r = (T) translate(replacements.remove(tree));
+                return r;
+            }
+            return super.translate(tree);
+        }
+
+        @Override
+        public void visitMethodDef(JCMethodDecl tree) {
+            Type prev = methodReturn;
+            methodReturn = tree.sym == null ? null : tree.sym.type.getReturnType();
+            super.visitMethodDef(tree);
+            methodReturn = prev;
+        }
+
+        @Override
+        public void visitLambda(JCLambda tree) {
+            Type prev = methodReturn;
+            methodReturn = null;
+            super.visitLambda(tree);
+            methodReturn = prev;
+        }
+
+        @Override
+        public void visitVarDef(JCVariableDecl tree) {
+            super.visitVarDef(tree);
+            if (tree.init == null || tree.sym == null) return;
+            checkAssign(tree.init.pos(), tree.init.type, tree.sym.type);
+            tree.init = coerce(tree.init, tree.sym.type);
+            if (tree.sym.owner.kind == Kind.MTH && !tree.sym.type.isPrimitive()) autoName(tree);
+        }
+
+        /** {@code T x = init;} becomes {@code T x = T.name(init, "x");} when T declares @Operator("name"). */
+        void autoName(JCVariableDecl tree) {
+            JCExpression init = TreeInfo.skipParens(tree.init);
+            if (init.hasTag(JCTree.Tag.IDENT) || init.hasTag(JCTree.Tag.LITERAL)) return;
+            Type t = tree.sym.type;
+            Name m = operatorMethod(t, "name", true);
+            if (m == null) return;
+            Symbol owner = null;
+            for (Type s = t; s != null && s.hasTag(CLASS) && owner == null; s = types.supertype(s))
+                for (Symbol x : s.tsym.members().getSymbolsByName(m)) if (x.kind == Kind.MTH) owner = x;
+            if (!(owner instanceof MethodSymbol ms)) return;
+            make.at(tree.init.pos);
+            JCExpression name = make.Literal(tree.name.toString()).setType(syms.stringType.constType(tree.name.toString()));
+            JCExpression c = make.App(make.QualIdent(ms), List.of(tree.init, name));
+            c.type = t;
+            tree.init = make.TypeCast(t, c).setType(t);
+        }
+
+        @Override
+        public void visitAssign(JCAssign tree) {
+            super.visitAssign(tree);
+            checkAssign(tree.rhs.pos(), tree.rhs.type, tree.lhs.type);
+            tree.rhs = coerce(tree.rhs, tree.lhs.type);
+        }
+
+        @Override
+        public void visitReturn(JCReturn tree) {
+            super.visitReturn(tree);
+            if (tree.expr != null && methodReturn != null) {
+                checkAssign(tree.expr.pos(), tree.expr.type, methodReturn);
+                tree.expr = coerce(tree.expr, methodReturn);
+            }
+        }
+
+        @Override
+        public void visitApply(JCMethodInvocation tree) {
+            super.visitApply(tree);
+            Symbol s = TreeInfo.symbol(tree.meth);
+            if (!(s instanceof MethodSymbol ms)) return;
+            List<Type> params = ms.type.getParameterTypes();
+            ListBuffer<JCExpression> args = new ListBuffer<>();
+            for (List<JCExpression> l = tree.args; l.nonEmpty(); l = l.tail) {
+                JCExpression a = l.head;
+                if (params.nonEmpty()) {
+                    Type p = params.head;
+                    if (!(params.tail.isEmpty() && ms.isVarArgs())) {
+                        checkAssign(a.pos(), a.type, p);
+                        a = coerce(a, p);
+                    }
+                    params = params.tail.isEmpty() ? params : params.tail;
+                }
+                args.append(a);
+            }
+            tree.args = args.toList();
+        }
+
+        @Override
+        public void visitTypeCast(JCTypeCast tree) {
+            super.visitTypeCast(tree);
+            Type to = tree.type;
+            Type from = tree.expr.type;
+            if (isUnsigned(from) && !isUnsigned(to) && (to.hasTag(LONG) || to.hasTag(FLOAT) || to.hasTag(DOUBLE))) {
+                result = coerce(tree.expr, to);
+                return;
+            }
+            if (to instanceof UnsignedType u && u.bits != 32 && u.bits != 64 && from.isNumeric()) {
+                // narrowing into a sub-word unsigned type: keep the low bits
+                JCExpression inner = tree.expr;
+                if (from.getTag() != u.getTag()) inner = make.TypeCast(syms.typeOfTag[u.getTag().ordinal()], inner).setType(syms.typeOfTag[u.getTag().ordinal()]);
+                result = masked(inner, u);
+            }
+        }
+
+        @Override
+        public void visitUnary(JCUnary tree) {
+            super.visitUnary(tree);
+            if (!(tree.type instanceof UnsignedType u)) return;
+            if (tree.hasTag(JCTree.Tag.COMPL) || tree.hasTag(JCTree.Tag.NEG)) result = masked(tree, u);
+        }
+
+        @Override
+        public void visitExec(JCExpressionStatement tree) {
+            // u++ / ++u / u += x on sub-word unsigned values: wrap to the width
+            JCExpression e = tree.expr;
+            if (e instanceof JCUnary un && un.getTag().isIncOrDecUnaryOp() && un.arg.type instanceof UnsignedType u
+                    && u.bits != 32 && u.bits != 64 && (un.arg.hasTag(JCTree.Tag.IDENT) || un.arg.hasTag(JCTree.Tag.SELECT))) {
+                boolean inc = un.hasTag(JCTree.Tag.PREINC) || un.hasTag(JCTree.Tag.POSTINC);
+                JCExpression one = intLit(u.getTag(), 1);
+                JCExpression rhs = masked(binary(inc ? JCTree.Tag.PLUS : JCTree.Tag.MINUS, un.arg, one, u), u);
+                JCAssign asg = make.at(tree.pos).Assign(un.arg, rhs);
+                asg.type = u;
+                tree.expr = asg;
+                result = tree;
+                return;
+            }
+            if (e instanceof JCAssignOp ao && ao.lhs.type instanceof UnsignedType u && (ao.lhs.hasTag(JCTree.Tag.IDENT) || ao.lhs.hasTag(JCTree.Tag.SELECT))) {
+                JCTree.Tag t = ao.getTag().noAssignOp();
+                JCBinary b = make.at(ao.pos).Binary(t, ao.lhs, ao.rhs);
+                b.operator = ao.operator;
+                b.type = u;
+                JCAssign asg = make.at(tree.pos).Assign(ao.lhs, b);
+                asg.type = u;
+                tree.expr = asg;
+                super.visitExec(tree);
+                return;
+            }
+            super.visitExec(tree);
+        }
+
+        @Override
+        public void visitBinary(JCBinary tree) {
+            super.visitBinary(tree);
+            Type lt = tree.lhs.type, rt = tree.rhs.type;
+            boolean ul = isUnsigned(lt), ur = isUnsigned(rt);
+            // string conversion of unsigned values
+            if (tree.hasTag(JCTree.Tag.PLUS) && types.isSameType(tree.type, syms.stringType)) {
+                if (ul) tree.lhs = toUnsignedString(tree.lhs);
+                if (ur) tree.rhs = toUnsignedString(tree.rhs);
+                if (ul || ur) tree.operator = operators.resolveBinary(tree, JCTree.Tag.PLUS, tree.lhs.type, tree.rhs.type);
+                return;
+            }
+            if (!ul && !ur) return;
+            // signed and unsigned operands may only meet through constants
+            if (ul != ur) {
+                Type signed = ul ? rt : lt;
+                Type uns = ul ? lt : rt;
+                boolean shift = tree.hasTag(JCTree.Tag.SL) || tree.hasTag(JCTree.Tag.SR) || tree.hasTag(JCTree.Tag.USR);
+                if (!shift && signed.isNumeric() && !isConstFitting(signed, ((UnsignedType) uns).bits))
+                    error(tree.pos(), "cannot mix signed " + signed.baseType() + " and " + uns + "; cast one of them");
+            }
+            // widen 32-bit unsigned operands of long operations by zero-extension
+            if (tree.operator != null && tree.operator.type.getParameterTypes().head.hasTag(LONG)) {
+                tree.lhs = coerce(tree.lhs, syms.longType);
+                tree.rhs = coerce(tree.rhs, syms.longType);
+            }
+            Type ot = (ul ? lt : rt);
+            int bits = bitsOf(ot);
+            TypeTag tag = tree.lhs.type.getTag() == LONG || tree.rhs.type.getTag() == LONG ? LONG : INT;
+            boolean full = (tag == INT && bits == 32) || (tag == LONG && bits == 64);
+            switch (tree.getTag()) {
+                case DIV, MOD -> {
+                    Type site = tag == LONG ? syms.longType : syms.intType;
+                    Type boxed = types.boxedClass(site).type;
+                    Type prim = tag == LONG ? syms.longType : syms.intType;
+                    result = call(boxed, tree.hasTag(JCTree.Tag.DIV) ? "divideUnsigned" : "remainderUnsigned",
+                            List.of(prim, prim), List.of(tree.lhs, tree.rhs));
+                    result.type = tree.type;
+                }
+                case LT, LE, GT, GE -> {
+                    if (full && ul && ur) {
+                        JCExpression min = intLit(tag, tag == LONG ? Long.MIN_VALUE : Integer.MIN_VALUE);
+                        Type p = tag == LONG ? syms.longType : syms.intType;
+                        tree.lhs = binary(JCTree.Tag.BITXOR, tree.lhs, min, p);
+                        tree.rhs = binary(JCTree.Tag.BITXOR, tree.rhs, intLit(tag, tag == LONG ? Long.MIN_VALUE : Integer.MIN_VALUE), p);
+                    } else if (full) {
+                        // unsigned vs non-negative constant: compare unsigned
+                        JCExpression l = tree.lhs, r = tree.rhs;
+                        Type p = tag == LONG ? syms.longType : syms.intType;
+                        tree.lhs = binary(JCTree.Tag.BITXOR, l, intLit(tag, tag == LONG ? Long.MIN_VALUE : Integer.MIN_VALUE), p);
+                        tree.rhs = binary(JCTree.Tag.BITXOR, r, intLit(tag, tag == LONG ? Long.MIN_VALUE : Integer.MIN_VALUE), p);
+                    }
+                }
+                case SR -> {
+                    if (ul) {
+                        tree.operator = operators.resolveBinary(tree, JCTree.Tag.USR, tree.lhs.type.baseType(), tree.rhs.type.baseType());
+                        JCBinary b = make.at(tree.pos).Binary(JCTree.Tag.USR, tree.lhs, tree.rhs);
+                        b.operator = tree.operator;
+                        b.type = tree.type;
+                        result = b;
+                    }
+                }
+                case PLUS, MINUS, MUL, SL -> result = masked(tree, tree.type);
+                default -> {}
+            }
+        }
+
+        JCExpression toUnsignedString(JCExpression e) {
+            var u = (UnsignedType) e.type;
+            if (u.bits != 32 && u.bits != 64) return e;
+            Type prim = u.getTag() == LONG ? syms.longType : syms.intType;
+            make.at(e.pos);
+            return call(types.boxedClass(prim).type, "toUnsignedString", List.of(prim), List.of(e));
+        }
+
+        @Override
+        public void visitIndexed(JCArrayAccess tree) {
+            super.visitIndexed(tree);
+            if (tree instanceof JCSlice s) s.lo = translate(s.lo);
+            if (!(tree.indexed.type instanceof UnsignedType u)) return;
+            TypeTag tag = u.getTag();
+            Type p = tag == LONG ? syms.longType : syms.intType;
+            make.at(tree.pos);
+            if (tree instanceof JCSlice s) {
+                int lo = ((Number) s.lo.type.constValue()).intValue();
+                JCExpression shifted = lo == 0 ? tree.indexed : binary(JCTree.Tag.USR, tree.indexed, intLit(INT, lo), p);
+                result = masked(shifted, tree.type);
+                result.type = tree.type;
+            } else {
+                JCExpression shifted = binary(JCTree.Tag.USR, tree.indexed, tree.index, p);
+                JCExpression bit = binary(JCTree.Tag.BITAND, shifted, intLit(tag, 1), p);
+                result = binary(JCTree.Tag.NE, bit, intLit(tag, 0), syms.booleanType);
+            }
+        }
+
+        @Override
+        public void visitNewArray(JCNewArray tree) {
+            super.visitNewArray(tree);
+            if (!(tree.type instanceof UnsignedType u)) return;
+            // {a, b, c}: a is the most significant part
+            make.at(tree.pos);
+            TypeTag tag = u.getTag();
+            Type p = tag == LONG ? syms.longType : syms.intType;
+            JCExpression acc = null;
+            int shift = 0;
+            for (List<JCExpression> l = tree.elems.reverse(); l.nonEmpty(); l = l.tail) {
+                JCExpression e = l.head;
+                if (tag == LONG && e.type.getTag() == INT) e = coerce(e, syms.longType);
+                JCExpression part = shift == 0 ? e : binary(JCTree.Tag.SL, e, intLit(INT, shift), p);
+                acc = acc == null ? part : binary(JCTree.Tag.BITOR, acc, part, p);
+                shift += bitsOf(l.head.type);
+            }
+            acc.type = u;
+            result = acc;
+        }
+    }
+}
