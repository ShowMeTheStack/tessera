+    // ---------------------------------------------------------------- Tessera syntax
+
+    /** Tessera: {@code 123u} / {@code 123uL}: a cast of the bit pattern to uint / ulong. */
+    JCExpression unsignedLiteral(Name prefix, int pos, int bits) {
+        String digits = token.stringVal();
+        digits = digits.substring(0, digits.length() - 1);
+        if (prefix == names.hyphen) {
+            log.error(DiagnosticFlag.SYNTAX, pos, Errors.Tessera("unsigned literals cannot be negative"));
+            return errorTree;
+        }
+        java.math.BigInteger v;
+        try {
+            v = new java.math.BigInteger(digits.replace("_", ""), token.radix());
+        } catch (NumberFormatException ex) {
+            reportIntegralLiteralError(prefix, pos);
+            return errorTree;
+        }
+        if (v.bitLength() > bits) {
+            log.error(DiagnosticFlag.SYNTAX, pos, Errors.Tessera("unsigned literal " + v + " does not fit in " + bits + " bits"));
+            return errorTree;
+        }
+        JCExpression lit = bits == 32 ? F.at(pos).Literal(TypeTag.INT, v.intValue())
+                : F.at(pos).Literal(TypeTag.LONG, v.longValue());
+        JCUnsignedTypeTree type = new JCUnsignedTypeTree(bits, false);
+        type.pos = pos;
+        return F.at(pos).TypeCast(type, lit);
+    }
+
+    /** Tessera: identifiers that name unsigned types when used as a type. */
+    boolean isUnsignedTypeName(Token t) {
+        if (t.kind != IDENTIFIER) return false;
+        String n = t.name().toString();
+        return n.equals("uint") || n.equals("ulong") || n.equals("ushort") || n.equals("ubyte") || n.equals("bits");
+    }
+
+    /** Tessera: is the identifier at {@code S.token(lookahead)} the start of an unsigned type? */
+    boolean unsignedTypeAhead(int lookahead) {
+        Token t = S.token(lookahead);
+        if (!isUnsignedTypeName(t)) return false;
+        boolean width = S.token(lookahead + 1).kind == LT && S.token(lookahead + 2).kind == INTLITERAL
+                && S.token(lookahead + 3).kind == GT;
+        if (t.name().toString().equals("bits")) return width;
+        if (width) return t.name().toString().equals("uint");
+        TokenKind next = S.token(lookahead + 1).kind;
+        return next == IDENTIFIER || next == UNDERSCORE || next == RPAREN || next == ELLIPSIS
+                || (next == LBRACKET && S.token(lookahead + 2).kind == RBRACKET);
+    }
+
+    /** Tessera: uint | ulong | ushort | ubyte | uint '<' N '>' | bits '<' N '>' */
+    JCPrimitiveTypeTree unsignedBasicType() {
+        int pos = token.pos;
+        String n = token.name().toString();
+        nextToken();
+        boolean raw = n.equals("bits");
+        int bits = switch (n) {
+            case "ulong" -> 64;
+            case "ushort" -> 16;
+            case "ubyte" -> 8;
