             super.visitTypeCast(tree);
+            make.at(tree.pos);
             Type to = tree.type;
             Type from = tree.expr.type;
+            if (isUnsigned(from) && from.getTag() == LONG && (to.hasTag(FLOAT) || to.hasTag(DOUBLE))) {
+                // a 64-bit unsigned value as floating point: through its decimal string, correctly rounded
+                JCExpression str = call(types.boxedClass(syms.longType).type, "toUnsignedString", List.of(syms.longType),
+                        List.of(tree.expr));
+                str.type = syms.stringType;
+                Type box = types.boxedClass(to).type;
+                result = call(box, to.hasTag(FLOAT) ? "parseFloat" : "parseDouble", List.of(syms.stringType), List.of(str));
+                result.type = to;
+                return;
+            }
             if (isUnsigned(from) && !isUnsigned(to) && (to.hasTag(LONG) || to.hasTag(FLOAT) || to.hasTag(DOUBLE))) {
-                result = coerce(tree.expr, to);
+                JCExpression c = coerce(tree.expr, to);
+                // a ulong cast to long keeps its bits: keep the cast, so the result is a signed long
+                result = c == tree.expr ? tree : c;
                 return;
             }
             if (to instanceof UnsignedType u && u.bits != 32 && u.bits != 64 && from.isNumeric()) {
@@ -483,6 +496,7 @@ public void visitTypeCast(JCTypeCast tree) {
